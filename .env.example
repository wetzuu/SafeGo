# Safe demo default: use built-in data even if PostgreSQL is installed locally.
# To use PostgreSQL/PostGIS, set SAFEGO_DATA_MODE=database and provide its URL.
SAFEGO_DATA_MODE=mock
# Example: postgresql://postgres:postgres@localhost:5432/safego
DATABASE_URL=
DATABASE_SSL=false

# No API key is required. Set to disabled for fully offline development.
SAFEGO_WEATHER_PROVIDER=open-meteo

# Development defaults use public OpenStreetMap/OSRM services. Configure hosted
# or self-hosted replacements before production traffic.
SAFEGO_GEOCODING_BASE_URL=https://nominatim.openstreetmap.org/search
SAFEGO_ROUTING_BASE_URL=https://router.project-osrm.org
SAFEGO_CONTACT_EMAIL=

# Keeps only the documented España-to-Lerma example usable when live OSRM is
# briefly unavailable. The UI clearly labels the saved route geometry.
SAFEGO_DEMO_ROUTE_FALLBACK=true

# Optional approved operational feeds. SafeGo expects the normalized JSON
# contracts documented in docs/SOURCE_FEEDS.md. Empty values stay disabled.
SAFEGO_OFFICIAL_ADVISORY_FEED_URL=
SAFEGO_OFFICIAL_ADVISORY_FEED_TOKEN=
SAFEGO_FLOOD_ROAD_FEED_URL=
SAFEGO_FLOOD_ROAD_FEED_TOKEN=

# Keep both false until a real moderation workflow is deployed.
SAFEGO_COMMUNITY_REPORTS_ENABLED=false
SAFEGO_MODERATION_ENABLED=false
